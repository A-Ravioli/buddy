<?xml version="1.0" encoding="utf-8"?>
<!--
  Privileged permissions buddy is allowed to hold. The build fails if the app requests
  a signature|privileged permission that is not listed here, which is the point: this
  file is the reviewable record of what buddy can do beyond an ordinary app.

  Phase 0 needs only usage stats. Later phases add, each with its own commit:
    android.permission.CAPTURE_AUDIO_OUTPUT       (calls, Phase 1)
    android.permission.CAPTURE_AUDIO_HOTWORD      (hotword, Phase 1)
    android.permission.INJECT_EVENTS              (actuation, Phase 2)
    android.permission.INTERACT_ACROSS_USERS      (only if a second user profile appears)
-->
<permissions>
    <privapp-permissions package="app.buddy">
        <permission name="android.permission.PACKAGE_USAGE_STATS" />
        <permission name="android.permission.READ_PRIVILEGED_PHONE_STATE" />
        <permission name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
        <!-- Phase 3: actuation through input injection. -->
        <permission name="android.permission.INJECT_EVENTS" />
        <!-- First-run setup: buddy replaces the setup wizard and marks the device
             provisioned when the walk-through ends. The rest of what setup needs
             (NETWORK_SETUP_WIZARD, SET_INITIAL_LOCK, ACCESS_KEYGUARD_SECURE_STORAGE)
             is signature-level, so the platform signature grants it without an entry. -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <!-- Patch 0013: disabling recents, which has no provider once the launcher is
             dropped from the build. -->
        <permission name="android.permission.STATUS_BAR" />
    </privapp-permissions>
</permissions>
