<?xml version="1.0" encoding="utf-8"?>
<!--
  Runtime permissions granted to buddy at first boot, so the phone never shows it a
  permission prompt. fixed="true" means the user cannot revoke them from Settings; buddy
  without its senses is not buddy, and the trust surface is the timeline, not a toggle.
-->
<exceptions>
    <exception package="app.buddy">
        <permission name="android.permission.READ_SMS" fixed="true" />
        <permission name="android.permission.RECEIVE_SMS" fixed="true" />
        <permission name="android.permission.RECEIVE_MMS" fixed="true" />
        <permission name="android.permission.RECEIVE_WAP_PUSH" fixed="true" />
        <permission name="android.permission.SEND_SMS" fixed="true" />
        <permission name="android.permission.READ_CALL_LOG" fixed="true" />
        <permission name="android.permission.READ_PHONE_STATE" fixed="true" />
        <permission name="android.permission.READ_CALENDAR" fixed="true" />
        <permission name="android.permission.READ_CONTACTS" fixed="true" />
        <permission name="android.permission.ACCESS_FINE_LOCATION" fixed="true" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" fixed="true" />
        <permission name="android.permission.ACCESS_BACKGROUND_LOCATION" fixed="true" />
        <permission name="android.permission.POST_NOTIFICATIONS" fixed="true" />
        <permission name="android.permission.RECORD_AUDIO" fixed="true" />
    </exception>
</exceptions>
