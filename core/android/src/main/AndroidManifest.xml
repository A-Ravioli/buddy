<?xml version="1.0" encoding="utf-8"?>
<!--
  buddy: the system app. Installed to /system_ext/priv-app by the platform build, signed
  with the platform key. Roles (home, assistant, SMS, dialer, call screening) and the
  content capture service are assigned to it by the framework config overlay in
  platform/overlay; the components below exist so those assignments are
  valid. Phase 0 components only read and record; nothing here acts.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.buddy">

    <!-- Perception: notifications, SMS, calls, calendar, contacts, location, device state. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Placing a call from a tel: link, as the dialer role holder (DialActivity). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- buddy's arrival: a chime and a tap, since no notification of his reaches anyone
         once the shade is closed (patch 0013). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The flat ground behind everything, set once at the end of the walk-through. -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Phase 1: the cloud planning cycle and its alarms. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Phase 3: input injection (signature, held by the platform-signed app) and the voice session. -->
    <uses-permission android:name="android.permission.INJECT_EVENTS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- First-run setup. buddy replaces the setup wizard (dropped from the build in
         Android.bp), so it does the wizard's work inside its own walk-through: join a
         network, set the first lock credential, and tell the framework setup is done.
         All signature or signature|privileged, held by the platform-signed app. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NETWORK_SETUP_WIZARD" />
    <uses-permission android:name="android.permission.ACCESS_KEYGUARD_SECURE_STORAGE" />
    <uses-permission android:name="android.permission.SET_INITIAL_LOCK" />
    <!-- Patch 0013: turning off the chrome that assumes a viewer. WRITE_SECURE_SETTINGS,
         above, also carries the lock screen's settings (patch 0015) and the two keys buddy
         publishes his face's state through, which SystemUI reads. -->
    <uses-permission android:name="android.permission.STATUS_BAR" />

    <application
        android:name="buddy.android.BuddyApp"
        android:label="@string/app_name"
        android:persistent="true"
        android:directBootAware="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- The surface: the chat with buddy, the creature, the timeline, the first-run
             walk-through. It is the HOME activity; there is no launcher grid behind it. -->
        <activity
            android:name="buddy.android.surface.SurfaceActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Buddy.Surface">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Priority on a HOME filter is honoured for system apps only; it is how buddy
                 wins the launcher role without a settings prompt. -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The debug timeline: every raw event in the ledger, one line each. Reached from
             the surface's playground; no longer the home. -->
        <activity
            android:name="buddy.android.ui.TimelineActivity"
            android:exported="false" />

        <!-- Perception host: keeps the content observers, location, and device-state
             receivers alive. Persistent app, so this survives without a user-visible
             foreground notification once the platform build marks it as such. -->
        <service
            android:name="buddy.android.perception.PerceptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|location" />

        <receiver
            android:name="buddy.android.BootReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- Notification stream. -->
        <service
            android:name="buddy.android.perception.BuddyNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Notification assistant: runs before a notification is shown and can hide it.
             Assigned by config_defaultAssistantAccessComponent in the overlay. -->
        <service
            android:name="buddy.android.perception.BuddyNotificationAssistant"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_ASSISTANT_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationAssistantService" />
            </intent-filter>
        </service>

        <!-- The brief and the escalation queue. -->
        <activity
            android:name="buddy.android.ui.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name="buddy.android.ui.BriefActivity"
            android:exported="true"
            android:launchMode="singleTop" />
        <receiver
            android:name="buddy.android.cognition.BriefScheduler$CycleReceiver"
            android:exported="false" />
        <service
            android:name="buddy.android.cognition.IdleJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- Content capture: the framework streams every app's view text here. Assigned
             by config_defaultContentCaptureService in the overlay. -->
        <service
            android:name="buddy.android.capture.BuddyContentCaptureService"
            android:exported="true"
            android:permission="android.permission.BIND_CONTENT_CAPTURE_SERVICE">
            <intent-filter>
                <action android:name="android.service.contentcapture.ContentCaptureService" />
            </intent-filter>
        </service>

        <!-- SMS role. As the default SMS app buddy must persist incoming messages to the
             provider itself; SmsDeliverReceiver does that and records the event. The other
             three components are required by the role and are stubs in Phase 0. -->
        <receiver
            android:name="buddy.android.perception.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="buddy.android.perception.MmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>
        <service
            android:name="buddy.android.perception.HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>
        <activity
            android:name="buddy.android.ui.ComposeSmsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <!-- Dialer role. buddy is the only in-call UI on this build: the phone app is not
             installed, so this service and CallActivity are what answers a call. -->
        <service
            android:name="buddy.android.perception.BuddyInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data android:name="android.telecom.IN_CALL_SERVICE_UI" android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
        <!-- The call itself. Over the lock screen, because a ringing phone is the one
             thing allowed to interrupt without asking, and out of recents, which is gone. -->
        <activity
            android:name="buddy.android.surface.call.CallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Buddy.Surface" />
        <activity
            android:name="buddy.android.ui.DialActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Call screening role. Phase 0: allow everything, record the attempt. -->
        <service
            android:name="buddy.android.perception.BuddyCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Assistant and voice interaction roles. Phase 0: the service exists so the role
             can be assigned; hotword and sessions arrive with the audio pipeline. -->
        <service
            android:name="buddy.android.voice.BuddyVoiceInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name="buddy.android.voice.BuddyVoiceSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <activity
            android:name="buddy.android.ui.AssistActivity"
            android:exported="true"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
